# World Stock News - Environment Variables for Vercel & MongoDB

# MongoDB Atlas Connection URI (Automatically injected by Vercel MongoDB Integration)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB Database Name (Optional, defaults to 'stock_market_news')
MONGODB_DB=stock_market_news

# Secret Key to secure Vercel Cron Jobs (Optional, recommended)
CRON_SECRET=your_vercel_cron_secret_here

# Local Development Port (Optional, defaults to 3000)
PORT=3000
